#!/usr/bin/env bash

set -u

MUSIC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/music"
MUSIC_FILE="$MUSIC_DIR/music.txt"

mkdir -p "$MUSIC_DIR"
touch "$MUSIC_FILE"

show_help() {
    cat <<EOF

YouTube Music Player

Usage:
  music                         Play a random URL
  music URL                     Play a specific URL
  music --list                  List saved URLs
  music --add URL               Add a URL
  music --remove URL            Remove a URL
  music --edit                  Edit the music library
  music --help                  Show this help

Examples:
  music
  music "https://www.youtube.com/watch?v=XXXXXXXX"
  music --add "https://www.youtube.com/watch?v=XXXXXXXX"
  music --add "https://www.youtube.com/playlist?list=XXXXXXXX"
  music --list
  music --remove "https://www.youtube.com/watch?v=XXXXXXXX"
  music --edit

Music library:
  $MUSIC_FILE

EOF
}

get_urls() {
    grep -v '^[[:space:]]*#' "$MUSIC_FILE" \
        | grep -v '^[[:space:]]*$'
}

list_urls() {
    echo
    echo "Saved URLs"
    echo "────────────────────────────────────────"

    local urls
    urls=$(get_urls)

    if [ -z "$urls" ]; then
        echo "No URLs saved."
    else
        echo "$urls" | nl -w2 -s'. '
    fi

    echo
}

add_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        echo "Error: URL is required."
        echo "Usage: music --add URL"
        exit 1
    fi

    if grep -Fxq "$url" "$MUSIC_FILE"; then
        echo "URL already exists:"
        echo "$url"
        exit 0
    fi

    echo "$url" >> "$MUSIC_FILE"

    echo "Added:"
    echo "$url"
}

remove_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        echo "Error: URL is required."
        echo "Usage: music --remove URL"
        exit 1
    fi

    if ! grep -Fxq "$url" "$MUSIC_FILE"; then
        echo "URL not found:"
        echo "$url"
        exit 1
    fi

    grep -Fxv "$url" "$MUSIC_FILE" > "$MUSIC_FILE.tmp"
    mv "$MUSIC_FILE.tmp" "$MUSIC_FILE"

    echo "Removed:"
    echo "$url"
}

play_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        url=$(get_urls | shuf -n 1)
    fi

    if [ -z "$url" ]; then
        echo "No URLs available."
        echo "Add one with:"
        echo
        echo "  music --add URL"
        echo
        exit 1
    fi

    echo
    echo "Now playing:"
    echo "$url"
    echo

    mpv --no-video "$url"
}

case "${1:-}" in

    "")
        play_url
        ;;

    --list|-l)
        list_urls
        ;;

    --add|-a)
        add_url "${2:-}"
        ;;

    --remove|-r)
        remove_url "${2:-}"
        ;;

    --edit|-e)
        "${EDITOR:-nano}" "$MUSIC_FILE"
        ;;

    --help|-h|help)
        show_help
        ;;

    http://*|https://*)
        play_url "$1"
        ;;

    *)
        echo "Error: unknown option '$1'"
        show_help
        exit 1
        ;;

esac

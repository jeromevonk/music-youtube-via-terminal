#!/usr/bin/env bash

set -u
trap 'exit 0' INT TERM

MUSIC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/music"
MUSIC_FILE="$MUSIC_DIR/music.txt"

mkdir -p "$MUSIC_DIR"
touch "$MUSIC_FILE"

show_help() {
    cat <<EOF

YouTube Music Player

Usage:
  music                         Play random URLs continuously
  music URL                     Play this URL, then continue randomly
  music --pause                 Toggle play/pause in the active player
  music --list                  List saved URLs
  music --add URL               Add a URL
  music --remove URL            Remove a URL
  music --edit                  Edit the music library
  music --help                  Show this help

Examples:
  music
  music "https://www.youtube.com/watch?v=XXXXXXXX"
  music --add "https://www.youtube.com/watch?v=XXXXXXXX"
  music --add "https://www.youtube.com/playlist?list=XXXXXXXX"
  music --list
  music --remove "https://www.youtube.com/watch?v=XXXXXXXX"
  music --edit

Music library:
  $MUSIC_FILE

EOF
}

get_urls() {
    grep -v '^[[:space:]]*#' "$MUSIC_FILE" \
        | grep -v '^[[:space:]]*$'
}

list_urls() {
    echo
    echo "Saved URLs"
    echo "────────────────────────────────────────"

    local urls
    urls=$(get_urls)

    if [ -z "$urls" ]; then
        echo "No URLs saved."
    else
        echo "$urls" | nl -w2 -s'. '
    fi

    echo
}

add_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        echo "Error: URL is required."
        echo "Usage: music --add URL"
        exit 1
    fi

    if grep -Fxq "$url" "$MUSIC_FILE"; then
        echo "URL already exists:"
        echo "$url"
        exit 0
    fi

    echo "$url" >> "$MUSIC_FILE"

    echo "Added:"
    echo "$url"
}

remove_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        echo "Error: URL is required."
        echo "Usage: music --remove URL"
        exit 1
    fi

    if ! grep -Fxq "$url" "$MUSIC_FILE"; then
        echo "URL not found:"
        echo "$url"
        exit 1
    fi

    grep -Fxv "$url" "$MUSIC_FILE" > "$MUSIC_FILE.tmp"
    mv "$MUSIC_FILE.tmp" "$MUSIC_FILE"

    echo "Removed:"
    echo "$url"
}

toggle_pause() {
    if [ ! -S /tmp/music-mpv.sock ]; then
        echo "No active music player found."
        exit 1
    fi

    printf '%s\n' '{ "command": ["cycle", "pause"] }' \
        | socat - UNIX-CONNECT:/tmp/music-mpv.sock > /dev/null
}

random_url() {
    local previous_url="${1:-}"
    local -a urls=()

    mapfile -t urls < <(get_urls)

    if [ "${#urls[@]}" -eq 0 ]; then
        return 1
    fi

    # Avoid playing the same library entry twice in a row when possible.
    if [ "${#urls[@]}" -gt 1 ] && [ -n "$previous_url" ]; then
        printf '%s\n' "${urls[@]}" | grep -Fxv "$previous_url" | shuf -n 1
    else
        printf '%s\n' "${urls[@]}" | shuf -n 1
    fi
}

play_url() {
    local url="${1:-}"

    if [ -z "$url" ]; then
        url=$(random_url)
    fi

    if [ -z "$url" ]; then
        echo "No URLs available."
        echo "Add one with:"
        echo
        echo "  music --add URL"
        echo
        exit 1
    fi

    echo
    echo "Now playing:"
    echo "$url"
    echo

    mpv --no-video \
        --input-ipc-server=/tmp/music-mpv.sock \
        "$url"
}

play_continuously() {
    local url="${1:-}"

    while true; do
        if [ -z "$url" ]; then
            url=$(random_url)
        fi

        if ! play_url "$url"; then
            return
        fi
        url=$(random_url "$url")
    done
}

case "${1:-}" in

    "")
        play_continuously
        ;;

    --pause|-p)
        toggle_pause
        ;;

    --list|-l)
        list_urls
        ;;

    --add|-a)
        add_url "${2:-}"
        ;;

    --remove|-r)
        remove_url "${2:-}"
        ;;

    --edit|-e)
        "${EDITOR:-nano}" "$MUSIC_FILE"
        ;;

    --help|-h|help)
        show_help
        ;;

    http://*|https://*)
        play_continuously "$1"
        ;;

    *)
        echo "Error: unknown option '$1'"
        show_help
        exit 1
        ;;

esac
